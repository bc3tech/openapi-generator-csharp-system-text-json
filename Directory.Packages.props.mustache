<Project>
<Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />
<PropertyGroup>
<ManagePackageVersionsCentrally>{{useCPM}}</ManagePackageVersionsCentrally>
</PropertyGroup>
{{#useCPM}}
  <ItemGroup>
  {{#useCompareNetObjects}}
    <PackageVersion Include="CompareNETObjects" Version="4.61.0" />{{! leave at this version until this is fixed https://github.com/GregFinzer/Compare-Net-Objects/issues/282 }}
  {{/useCompareNetObjects}}
  {{^useGenericHost}}
    <PackageVersion Include="Macross.Json.Extensions" Version="3.0.0" />
  {{/useGenericHost}}
  {{#useRestSharp}}
    <PackageVersion Include="RestSharp" Version="110.2.0" />
  {{/useRestSharp}}
  {{#useGenericHost}}
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="{{#lambda.first}}{{#netStandard}}5.0.0{{/netStandard}}{{#net47}}7.0.0{{/net47}}{{#net48}}7.0.0{{/net48}}{{#net6.0}}6.0.1{{/net6.0}}{{#net70OrLater}}8.0.1{{/net70OrLater}}{{/lambda.first}}" />
    {{#supportsRetry}}
      <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="{{#lambda.first}}{{#netStandard}}5.0.1{{/netStandard}}{{#net47}}7.0.0{{/net47}}{{#net48}}7.0.0{{/net48}}{{#net6.0}}6.0.19{{/net6.0}}{{#net70OrLater}}8.0.12{{/net70OrLater}}{{/lambda.first}}" />
    {{/supportsRetry}}
    {{^supportsRetry}}
      <PackageVersion Include="Microsoft.Extensions.Http" Version="{{#lambda.first}}{{#netStandard}}5.0.0{{/netStandard}}{{#net47}}7.0.0{{/net47}}{{#net48}}7.0.0{{/net48}}{{#net6.0}}6.0.0{{/net6.0}}{{#net70OrLater}}7.0.0{{/net70OrLater}}{{/lambda.first}}" />
    {{/supportsRetry}}
  {{/useGenericHost}}
  {{^useGenericHost}}
    {{#supportsRetry}}
      <PackageVersion Include="Polly" Version="{{^netStandard}}7.2.3{{/netStandard}}{{#netStandard}}7.2.3{{/netStandard}}" />
    {{/supportsRetry}}
  {{/useGenericHost}}
  {{#validatable}}
    {{^net60OrLater}}
      <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    {{/net60OrLater}}
  {{/validatable}}
  </ItemGroup>
  
  <ItemGroup>
  <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="{{^netStandard}}17.6.3{{/netStandard}}{{#netStandard}}15.9.2{{/netStandard}}" />
  <PackageVersion Include="xunit" Version="{{^netStandard}}2.5.0{{/netStandard}}{{#netStandard}}2.4.2{{/netStandard}}" />
  <PackageVersion Include="xunit.runner.visualstudio" Version="{{^netStandard}}2.5.0{{/netStandard}}{{#netStandard}}2.4.5{{/netStandard}}" />
  </ItemGroup>
{{/useCPM}}
</Project>
